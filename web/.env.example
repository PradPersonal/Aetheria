# Web Service Environment Configuration

# API Service URLs (Backend Services)
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_STREAMING_URL=http://localhost:3002/api
REACT_APP_CHAT_URL=http://localhost:3003/api
REACT_APP_CORE_API_URL=http://localhost:3004/api

# WebSocket URLs
REACT_APP_WS_URL=ws://localhost:3003

# App Configuration
REACT_APP_APP_NAME=Aetheria
REACT_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=production

# Feature Flags
REACT_APP_ENABLE_CHAT=true
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_DEBUG=false

# External Services (Optional)
# REACT_APP_ANALYTICS_ID=GA-XXXXXXXXX
# REACT_APP_SENTRY_DSN=https://xxx@sentry.io/xxx

# Production URLs Example:
# REACT_APP_API_URL=https://api.yourdomain.com/api
# REACT_APP_STREAMING_URL=https://streaming.yourdomain.com/api
# REACT_APP_CHAT_URL=https://chat.yourdomain.com/api
# REACT_APP_CORE_API_URL=https://core.yourdomain.com/api
# REACT_APP_WS_URL=wss://chat.yourdomain.com