# Chat Service Environment Configuration

# Server Configuration
PORT=3003
NODE_ENV=production
SERVICE_NAME=Chat Service
SERVICE_VERSION=1.0.0

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# WebSocket Configuration (if needed)
WS_PORT=3303

# Redis Configuration (for chat sessions/caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100